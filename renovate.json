{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Bump the builder and runtime Caddy images together",
      "matchDatasources": ["docker"],
      "matchDepNames": ["caddy"],
      "groupName": "caddy"
    },
    {
      "description": "Caddy minor/patch releases and upstream rebuilds need no review; CI gates the merge",
      "matchDatasources": ["docker"],
      "matchDepNames": ["caddy"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "caddy-dns/inwx module version",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG INWX_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "caddy-dns/inwx"
    }
  ]
}
